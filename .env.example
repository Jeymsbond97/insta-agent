# Bu namuna fayl. Undan nusxa olib, `.env` deb nomlang va qiymatlarni o'zingiz yozing:
#   cp .env.example .env
#   open -e .env
# `.env` faylni hech kimga (Claude'ga ham) ko'rsatmang.

# --- Gemini (aistudio.google.com → Get API key) ---
GEMINI_API_KEY=

# --- ElevenLabs (ovoz klon) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- Bepul stok kadrlar ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
NASA_API_KEY=DEMO_KEY

# --- Instagram (Meta Graph API) ---
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- YouTube Data API (OAuth fayl yo'li) ---
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json

# --- Ixtiyoriy: X API ---
X_BEARER_TOKEN=
